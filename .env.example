# HTTP service
PORT=8787
HOST=0.0.0.0

# CloudDrive2 gRPC endpoint (default port is shown in the CloudDrive2 settings page, commonly 19798)
CLOUDDRIVE_GRPC_ADDR=127.0.0.1:19798
CLOUDDRIVE_GRPC_TLS=0

# Auth: prefer a scoped API token created in CloudDrive2. Otherwise set username/password (+ TOTP).
CLOUDDRIVE_TOKEN=
CLOUDDRIVE_USERNAME=
CLOUDDRIVE_PASSWORD=
CLOUDDRIVE_TOTP=

# Optional: pin the cloud account used to query offline task status.
# If empty, the first cloud account returned by CloudDrive2 is used.
CLOUDDRIVE_CLOUD_NAME=
CLOUDDRIVE_CLOUD_ACCOUNT=

# Offline status: snapshot only (0) or wait up to N ms for tasks to finish/error.
OFFLINE_WAIT_MS=0

# Use the in-memory mock cloud client (no CloudDrive2 needed). Handy for local dev/tests.
CLOUDDRIVE_MOCK=1

# CloudDrive2 path that maps to the 115 cloud, used as the parent of the created folder.
# Example: /115 or /115/我的资源
CD_PARENT_PATH=/115

# Regex matched against archive entry names to find files that contain offline links.
LINK_FILE_REGEX=\\.(txt|url|list|md)$

# Comma separated file extensions to keep. A line is a target only if it is a
# 115 cloud link (ed2k/magnet) whose file-name field ends with one of these.
# Leave empty to keep every 115 cloud link regardless of extension.
TARGET_EXTENSIONS=mp4
